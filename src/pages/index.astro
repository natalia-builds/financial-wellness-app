---
import { Card } from 'accessible-astro-components';
import Base from '../layouts/Base.astro';
import { groupTools } from '../lib/tools';
import '../styles/cards.css';
import { text } from '../text/en';

const t = text.home;
const tools = groupTools().flatMap((group) => group.tools);
---

<Base title={t.title} description={t.description}>
  <h1>{t.heading}</h1>
  <p>{t.intro}</p>
  <h2>{t.toolsHeading}</h2>
  <ul class="tool-list">
    {
      tools.map((tool) => (
        <li>
          <Card title={text.toolList[tool.key].title} url={tool.url} img={tool.icon} width={44} height={44}>
            {text.toolList[tool.key].summary}
          </Card>
        </li>
      ))
    }
  </ul>
  <p><a href="/tools/">{t.allToolsLink}</a></p>
</Base>
