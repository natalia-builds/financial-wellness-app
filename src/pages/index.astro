---
import { Card } from 'accessible-astro-components';
import Base from '../layouts/Base.astro';
import '../styles/cards.css';
import { text } from '../text/en';

const t = text.home;
---

<Base title={t.title} description={t.description}>
  <h1>{t.heading}</h1>
  <p>{t.intro}</p>
  <h2>{t.toolsHeading}</h2>
  <ul class="tool-list">
    <li>
      <Card title={t.creditToolLink} url="/credit-score-and-interest/" img="/icons/gauge.svg" width={44} height={44}>
        {t.creditToolSummary}
      </Card>
    </li>
    <li>
      <Card title={t.debtToolLink} url="/debt-or-emergency-fund/" img="/icons/scale.svg" width={44} height={44}>
        {t.debtToolSummary}
      </Card>
    </li>
  </ul>
</Base>
