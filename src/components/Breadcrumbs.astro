---
import { Breadcrumbs as LibraryBreadcrumbs, BreadcrumbsItem } from 'accessible-astro-components';
import { text } from '../text/en';

export interface Crumb {
  label: string;
  href?: string; // Leave out for the current page
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
const trail: Crumb[] = [{ label: text.site.home, href: '/' }, ...crumbs];
---

<LibraryBreadcrumbs ariaLabel={text.site.breadcrumbLabel}>
  {
    trail.map((crumb) => (
      <BreadcrumbsItem label={crumb.label} href={crumb.href} currentPage={!crumb.href}>
        <span slot="separator" class="separator" aria-hidden="true">
          ›
        </span>
      </BreadcrumbsItem>
    ))
  }
</LibraryBreadcrumbs>

<style>
  :global(.breadcrumbs) {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  :global(.breadcrumbs span[aria-current='page']) {
    font-weight: 400;
  }

  :global(.breadcrumbs a) {
    color: var(--accent);
  }
</style>
