---
import { SkipLink } from 'accessible-astro-components';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { Crumb } from '../components/Breadcrumbs.astro';
import '../styles/theme.css';
import { text } from '../text/en';

interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
}

const { title, description, crumbs } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <SkipLink text={text.site.skipLink} />
    <header>
      <div class="header-content">
        <a href="/" class="site-name">{text.site.name}</a>
        {crumbs && <Breadcrumbs crumbs={crumbs} />}
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <p>{text.site.footer}</p>
      <p><a href="https://github.com/natalia-builds/financial-wellness-app">{text.site.sourceCode}</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --background: #fbf8ef;
    --surface: #ffffff;
    --text: #1f2a2e;
    --muted: #55605f;
    --border: #ddd9cc;
    --accent: #0b6b5d;
    --highlight: #fdeec2;
    --band: #0b6b5d;
    --band-text: #ffffff;
    --error-text: #b3261e;
    --error-border: #c9342b;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --background: #14191b;
      --surface: #1d2427;
      --text: #eef1f0;
      --muted: #aeb8bc;
      --border: #3a4448;
      --accent: #6fd6c4;
      --highlight: #4a3a10;
      --band: #163f39;
      --band-text: #eafaf6;
      --error-text: #ffb4ab;
      --error-border: #ff8f85;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  header {
    background: var(--band);
    color: var(--band-text);
  }

  .header-content,
  main,
  footer {
    max-width: 44rem;
    margin: 0 auto;
    padding: 1rem;
  }

  a {
    color: var(--accent);
  }

  .site-name {
    color: var(--band-text);
    font-weight: 700;
    text-decoration: none;
  }

  h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0.5rem 0 1rem;
  }

  h2 {
    font-size: 1.35rem;
    margin: 2rem 0 0.5rem;
  }

  footer {
    margin-top: 2rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  header :focus-visible {
    outline-color: var(--band-text);
  }

  /* Drawn inside the link, so it never sits on the header band. */
  .skip-link a:focus-visible {
    outline-offset: -5px;
  }
</style>
