---
import { SkipLink } from 'accessible-astro-components';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import type { Crumb } from '../components/Breadcrumbs.astro';
import { pageTitle } from '../lib/page-title';
import '../styles/theme.css';
import { text } from '../text/en';

interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
}

const { title, description, crumbs } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle(title)}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <SkipLink text={text.site.skipLink} />
    <header>
      <div class="header-content">
        <a href="/" class="site-name">{text.site.name}</a>
        {crumbs && <Breadcrumbs crumbs={crumbs} />}
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer>
      <p>{text.site.footer}</p>
      <p>{text.site.counting}</p>
      <p><a href="https://github.com/natalia-builds/financial-wellness-app">{text.site.sourceCode}</a></p>
    </footer>
  </body>
</html>

{/* Loads anonymous counting on the live site only. See src/lib/count.ts. */}
<script>
  import { startCounting } from '../lib/count';

  startCounting();
</script>

<style is:global>
  :root {
    color-scheme: light dark;
    --background: #f1f8f5;
    --surface: #ffffff;
    --text: #16302c;
    --muted: #48605b;
    --border: #c5dcd5;
    --accent: #00695a;
    --highlight: #d3f0e7;
    --band: #d3f0e7;
    --band-text: #16302c;
    --band-link: #00594c;
    --error-text: #b3261e;
    --error-border: #c9342b;
    --warning-text: #5a3b00;
    --warning-bg: #fff3d1;
    --warning-border: #946200;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --background: #101c1b;
      --surface: #182725;
      --text: #ecf4f1;
      --muted: #a9bcb7;
      --border: #33504a;
      --accent: #63dcc6;
      --highlight: #1b4039;
      --band: #173330;
      --band-text: #ecf4f1;
      --band-link: #63dcc6;
      --error-text: #ffb4ab;
      --error-border: #ff8f85;
      --warning-text: #ffe0a3;
      --warning-bg: #3a2c0c;
      --warning-border: #e5a93c;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--background);
    color: var(--text);
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  header {
    background: var(--band);
    color: var(--band-text);
  }

  .header-content,
  main,
  footer {
    max-width: 44rem;
    margin: 0 auto;
    padding: 1rem;
  }

  a {
    color: var(--accent);
  }

  .site-name {
    color: var(--band-link);
    font-weight: 700;
    text-decoration: none;
  }

  h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0.5rem 0 1rem;
  }

  h2 {
    font-size: 1.35rem;
    margin: 2rem 0 0.5rem;
  }

  footer {
    margin-top: 2rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.9rem;
  }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  header :focus-visible {
    outline-color: var(--band-text);
  }

  /* Drawn inside the link, so it never sits on the header band. */
  .skip-link a:focus-visible {
    outline-offset: -5px;
  }
</style>
